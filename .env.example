# vLLM Engine Configuration
VLLM_MODEL=mistralai/Mistral-7B-Instruct-v0.2
VLLM_HOST=0.0.0.0
# API port. Do not use VLLM_PORT: vLLM reads it as its internal IPC port.
VLLM_DEPLOYMENT_PORT=8000
VLLM_MAX_NUM_BATCHED_TOKENS=8192
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_MODEL_LEN=4096

# Locust Load Testing Configuration
LOCUST_HOST=http://127.0.0.1:8000
LOCUST_USERS=50
LOCUST_SPAWN_RATE=10
LOCUST_RUN_TIME=60s

# Compose orchestration (compose.yaml interpolation only; deliberately not VLLM_*
# prefixed, because the strict Python config rejects unknown VLLM_* keys).
VLLM_TENSOR_PARALLEL_SIZE=1
SERVER_IMAGE=vllm/vllm-openai:latest
SERVER_HEALTH_START_PERIOD=30s
SERVER_SHM_SIZE=16g
MOCK_PORT=8001
APP_IMAGE_TAG=local
LOADGEN_TARGET_URL=http://vllm-mock:8000
HF_TOKEN=
